/* Clipboard (SUPER+V): histórico do cliphist em grade 4x3, com miniatura
 * das imagens e as primeiras linhas do texto.
 * Mesmo visual do seletor de temas; cores da paleta do tema ativo. */

@import "../shared/colors.rasi"
@import "../shared/fonts.rasi"

configuration {
    show-icons:                  true;
}

* {
    /* a paleta pode não definir todos os nomes, então há valores reserva */
    cor-fundo:                   var(background, #000000);
    cor-fundo-alt:               var(background-alt, #1c1c1c);
    cor-texto:                   var(foreground, #ffffff);
    cor-destaque:                var(selected, #ffffff);
    cor-borda:                   var(border-color, #ffffff);
}

window {
    location:                    center;
    anchor:                      center;
    width:                       920px;
    border:                      3px solid;
    border-radius:               12px;
    border-color:                @cor-borda;
    background-color:            @cor-fundo;
}

mainbox {
    spacing:                     15px;
    padding:                     20px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
}

/* Busca: prompt, texto digitado e contador (filtrados/total) */
inputbar {
    spacing:                     10px;
    padding:                     10px 15px;
    border:                      2px solid;
    border-radius:               10px;
    border-color:                @cor-destaque;
    background-color:            transparent;
    text-color:                  @cor-texto;
    children:                    [ "prompt", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}
prompt, entry, num-filtered-rows, textbox-num-sep, num-rows {
    background-color:            transparent;
    text-color:                  inherit;
}
prompt {
    font:                        "JetBrainsMono Nerd Font Bold 10";
}
entry {
    placeholder:                 "Buscar no histórico";
    placeholder-color:           inherit;
    cursor:                      text;
}
num-filtered-rows, textbox-num-sep, num-rows {
    expand:                      false;
}
textbox-num-sep {
    str:                         "/";
}

/* Dica de atalhos (-mesg do clipboard.sh) */
message {
    padding:                     0px 15px;
    border:                      0px;
    background-color:            transparent;
}
textbox {
    background-color:            transparent;
    text-color:                  @cor-texto;
}

listview {
    columns:                     4;
    lines:                       3;
    spacing:                     10px;
    cycle:                       true;
    dynamic:                     true;
    fixed-height:                true;
    scrollbar:                   false;
    background-color:            transparent;
}

/* Cada quadrado: miniatura (ou ícone de texto) em cima, texto embaixo */
element {
    orientation:                 vertical;
    spacing:                     8px;
    padding:                     10px;
    border:                      2px solid;
    border-radius:               8px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  @cor-texto;
    cursor:                      pointer;
}
element alternate.normal {
    background-color:            @cor-fundo-alt;
}
element selected.normal {
    border-color:                @cor-destaque;
}
element-icon {
    size:                        110px;
    border-radius:               6px;
    background-color:            transparent;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   bold;
    cursor:                      inherit;
    vertical-align:              0.0;
    horizontal-align:            0.5;
}

error-message {
    padding:                     20px;
    background-color:            @cor-fundo;
    text-color:                  @cor-texto;
}
