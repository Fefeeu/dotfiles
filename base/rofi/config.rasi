/* Configuração geral do rofi 2.0 (vale para todo rofi aberto).
 * Cores, fontes e layout ficam nos .rasi de cada menu, que importam shared/. */

configuration {
    /* Modos e busca */
    modi:                   "drun,run,filebrowser,window";
    case-sensitive:         false;
    normalize-match:        true;
    drun-match-fields:      "name,generic,exec,categories,keywords";

    /* Ícones */
    show-icons:             true;
    icon-theme:             "Papirus";
    run,drun {
        fallback-icon:      "application-x-addon";
    }

    /* Terminal usado pelo modo run e por apps de terminal */
    terminal:               "kitty";

    /* Nomes dos modos */
    display-drun:           "Apps";
    display-run:            "Run";
    display-window:         "Janelas";
    display-filebrowser:    "Arquivos";

    /* Fonte reserva, para rofi aberto sem -theme */
    font:                   "JetBrainsMono Nerd Font 10";

    /* Navegador de arquivos: pastas primeiro */
    filebrowser {
        directories-first:  true;
        sorting-method:     "name";
    }

    /* Clicar fora fecha o menu */
    click-to-exit:          true;
}
