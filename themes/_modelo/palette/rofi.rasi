/* Paleta <nome> — rofi
 * Nomes usados pelo layout base (adi1090x). */

* {
    background:         #000000;
    background-window:  #000000e6;  /* fundo da janela: últimos 2 dígitos = opacidade */
    background-alt:     #1c1c1c;
    foreground:         #ffffff;
    selected:           #ffffff;
    border-color:       #ffffff;
}
