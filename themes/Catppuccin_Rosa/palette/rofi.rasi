/* Paleta Catppuccin Mocha — cores do rofi
 *
 * Nomes usados pelo layout base (adi1090x):
 *   background, background-window, background-alt, foreground, selected, border-color
 */

* {
    highlight:          bold italic;
    scrollbar:          true;

    background:         #1e1e2e;    /* base */
    background-window:  #1e1e2ee6;  /* base 90% opaco (e6 = 230/255) */
    background-alt:     #313244;    /* surface0 */
    foreground:         #cdd6f4;    /* text */
    selected:           #e0b4ef;    /* rosa-mauve */
    border-color:       #e0b4ef;    /* rosa-mauve */

    background-color:   @background;
    separatorcolor:     @border-color;
    scrollbar-handle:   @border-color;

    /* estados usados pelo tema padrão do rofi */
    normal-background:  @background;
    normal-foreground:  @foreground;
    active-foreground:  @background;
    urgent-foreground:  @background;
}
